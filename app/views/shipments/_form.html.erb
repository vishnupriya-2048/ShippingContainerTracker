<%= form_with model: shipment do |form| %>
  <% if shipment.errors.any? %>
    <div>
      <h2><%= pluralize(shipment.errors.count, "error") %> prevented this shipment from being saved:</h2>
      <ul>
        <% shipment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :shipment_identifier %>
    <%= form.text_field :shipment_identifier %>
  </div>
  <div>
    <%= form.label :current_status %>
    <%= form.select :current_status, Shipment.current_statuses.keys.map { |s| [s.humanize, s] } %>
  </div>
  <div>
    <%= form.label :weight, "Weight (kg)" %>
    <%= form.number_field :weight, step: :any %>
  </div>
  <div>
    <%= form.label :height, "Height (cm)" %>
    <%= form.number_field :height, step: :any %>
  </div>
  <div>
    <%= form.label :source_address %>
    <%= form.text_field :source_address %>
  </div>
  <div>
    <%= form.label :source_latitude %>
    <%= form.number_field :source_latitude, step: :any %>
  </div>
  <div>
    <%= form.label :source_longitude %>
    <%= form.number_field :source_longitude, step: :any %>
  </div>
  <div>
    <%= form.label :destination_address %>
    <%= form.text_field :destination_address %>
  </div>
  <div>
    <%= form.label :destination_latitude %>
    <%= form.number_field :destination_latitude, step: :any %>
  </div>
  <div>
    <%= form.label :destination_longitude %>
    <%= form.number_field :destination_longitude, step: :any %>
  </div>

  <%= form.submit %>
<% end %>
