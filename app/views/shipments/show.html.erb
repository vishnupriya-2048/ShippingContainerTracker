<% content_for :main_class, "mx-auto w-full max-w-6xl space-y-6 px-5 py-8" %>
<% content_for :title, "#{@shipment.shipment_identifier} · Shipment Tracker" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <%= link_to shipments_path, class: "text-sm text-slate-500 hover:text-indigo-600" do %>
      <span aria-hidden="true">&larr;</span> All shipments
    <% end %>
    <div class="mt-1 flex flex-wrap items-center gap-3">
      <h1 class="text-2xl font-semibold tracking-tight"><%= @shipment.shipment_identifier %></h1>
      <%= status_badge(@shipment.current_status) %>
    </div>
    <p class="mt-1 text-sm text-slate-500">
      <% if @locations.any? %>
        <%= pluralize(@locations.size, "location update") %> · last seen
        <time datetime="<%= @locations.last.recorded_at.iso8601 %>" title="<%= l(@locations.last.recorded_at, format: :long) %>"><%= time_ago_in_words(@locations.last.recorded_at) %> ago</time>
      <% else %>
        No location reported yet
      <% end %>
    </p>
  </div>

  <div class="flex items-center gap-2">
    <%= link_to "Edit", edit_shipment_path(@shipment),
          class: "rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-inset ring-slate-300 transition hover:bg-slate-50" %>
    <%= button_to "Delete", @shipment, method: :delete,
          form: { data: { turbo_confirm: "Delete this shipment and its location history?" } },
          class: "rounded-lg bg-white px-3 py-1.5 text-sm font-medium text-red-600 ring-1 ring-inset ring-red-200 transition hover:bg-red-50" %>
  </div>
</div>

<section aria-label="Shipment details" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
  <% [
       ["Weight", "#{number_with_delimiter(@shipment.weight)} kg"],
       ["Height", "#{number_with_delimiter(@shipment.height)} cm"]
     ].each do |label, value| %>
    <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= label %></p>
      <p class="mt-1 text-lg font-semibold tabular-nums"><%= value %></p>
    </div>
  <% end %>

  <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-slate-500">
      <span class="grid size-4 place-items-center rounded-full bg-green-600 text-[9px] font-bold text-white">A</span> Source
    </p>
    <p class="mt-1 text-sm font-medium text-slate-800"><%= @shipment.source_address %></p>
  </div>

  <div class="rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
    <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-wide text-slate-500">
      <span class="grid size-4 place-items-center rounded-full bg-slate-900 text-[9px] font-bold text-white">B</span> Destination
    </p>
    <p class="mt-1 text-sm font-medium text-slate-800"><%= @shipment.destination_address %></p>
  </div>
</section>

<% trail = trail_data_for(@shipment, @locations, @status_histories) %>
<div class="space-y-6"
     data-controller="trail"
     data-trail-arrived-value="<%= trail[:arrived] %>"
     data-trail-path-value="<%= trail[:path].to_json %>"
     data-trail-current-value="<%= trail[:current].to_json %>"
     data-trail-source-value="<%= trail[:source].to_json %>"
     data-trail-destination-value="<%= trail[:destination].to_json %>"
     data-trail-statuses-value="<%= trail[:statuses].to_json %>"
     data-trail-points-value="<%= trail[:points].to_json %>">
<section class="relative h-[28rem] overflow-hidden rounded-2xl bg-slate-200 shadow-sm ring-1 ring-slate-200 lg:h-[34rem]">
  <div data-trail-target="canvas" class="absolute inset-0"></div>

  <div data-trail-target="message" hidden
       class="absolute inset-0 grid place-items-center bg-slate-100 p-8 text-center">
    <div class="max-w-sm">
      <p class="font-semibold text-slate-800">The map couldn't be loaded</p>
      <p class="mt-1 text-sm text-slate-500">Check that <code class="rounded bg-white px-1 py-0.5 text-xs">MAPS_JS_API_KEY</code> is set in <code class="rounded bg-white px-1 py-0.5 text-xs">.env</code> and that the Maps JavaScript API is enabled for it (see setup.md, section 12).</p>
    </div>
  </div>

  <ul class="pointer-events-none absolute bottom-3 left-3 flex flex-wrap gap-x-4 gap-y-1 rounded-lg bg-white/90 px-3 py-2 text-xs text-slate-600 shadow ring-1 ring-slate-200 backdrop-blur">
    <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-green-600"></span>Source</li>
    <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-slate-900"></span>Destination</li>
    <li class="flex items-center gap-1.5"><span class="h-0.5 w-4 rounded bg-indigo-500"></span>Trail</li>
    <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-full bg-amber-500 ring-2 ring-white"></span>Status change</li>
    <% unless @shipment.delivered? %>
      <li class="flex items-center gap-1.5"><span class="size-2.5 rounded-full" style="background-color: <%= status_style(@shipment.current_status)[:hex] %>"></span>Current</li>
    <% end %>
  </ul>
</section>

<section class="rounded-2xl bg-white shadow-sm ring-1 ring-slate-200" data-controller="tabs">
  <div role="tablist" aria-label="Shipment history" class="flex gap-1 border-b border-slate-200 px-3 pt-2">
    <% [["Status History", @status_histories.size], ["Location Trail", @locations.size]].each_with_index do |(label, count), i| %>
      <button type="button" role="tab" id="tab-<%= i %>" aria-controls="panel-<%= i %>"
              aria-selected="<%= i.zero? %>" tabindex="<%= i.zero? ? 0 : -1 %>"
              data-tabs-target="tab" data-action="click->tabs#show keydown->tabs#key" data-tabs-index-param="<%= i %>"
              class="-mb-px rounded-t-lg border-b-2 border-transparent px-4 py-2 text-sm font-medium text-slate-500 transition hover:text-slate-800 aria-selected:border-indigo-500 aria-selected:text-indigo-600">
        <%= label %> <span class="ml-1 rounded-full bg-slate-100 px-1.5 py-0.5 text-xs tabular-nums text-slate-600"><%= count %></span>
      </button>
    <% end %>
  </div>

  <div role="tabpanel" id="panel-0" aria-labelledby="tab-0" data-tabs-target="panel" class="p-4">
    <% if @status_histories.empty? %>
      <p class="py-6 text-center text-sm text-slate-500">No status changes yet. They appear as the shipment moves past the source and destination geofences.</p>
    <% else %>
      <ol class="max-h-96 divide-y divide-slate-100 overflow-y-auto">
        <% @status_histories.each do |history| %>
          <li>
            <button type="button" aria-pressed="false" data-action="trail#focusStatus" data-trail-id-param="<%= history.id %>"
                    class="flex w-full items-start gap-3 rounded-lg px-2 py-3 text-left transition hover:bg-slate-50 aria-pressed:bg-indigo-50">
              <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full text-[11px] font-bold text-white" style="background-color: <%= status_style(history.status)[:hex] %>"><%= status_style(history.status)[:glyph] %></span>
              <span class="min-w-0 flex-1">
                <span class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <%= status_badge(history.status) %>
                  <time class="text-xs text-slate-500" datetime="<%= history.changed_at.iso8601 %>"><%= l(history.changed_at, format: :long) %></time>
                </span>
                <span class="mt-1 block text-sm text-slate-700"><%= history.address.presence || "#{history.latitude.round(4)}, #{history.longitude.round(4)}" %></span>
                <% if history.notes.present? %><span class="mt-0.5 block text-xs text-slate-500"><%= history.notes %></span><% end %>
              </span>
            </button>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>

  <div role="tabpanel" id="panel-1" aria-labelledby="tab-1" data-tabs-target="panel" hidden class="p-4">
    <% if @locations.empty? %>
      <p class="py-6 text-center text-sm text-slate-500">No location reported yet. Run the simulator to publish points for this shipment.</p>
    <% else %>
      <div class="max-h-96 overflow-y-auto">
        <table class="w-full text-left text-sm">
          <thead class="sticky top-0 bg-white text-xs uppercase tracking-wide text-slate-500">
            <tr><th class="py-2 pr-3 font-medium">#</th><th class="py-2 pr-3 font-medium">Recorded</th><th class="py-2 pr-3 font-medium">Coordinates</th><th class="py-2 text-right font-medium">Speed</th></tr>
          </thead>
          <tbody class="divide-y divide-slate-100 tabular-nums">
            <% @locations.each_with_index do |location, i| %>
              <tr tabindex="0" aria-selected="false" data-action="click->trail#focusPoint keydown.enter->trail#focusPoint" data-trail-index-param="<%= i %>"
                  class="cursor-pointer transition hover:bg-slate-50 aria-selected:bg-indigo-50">
                <td class="py-2 pr-3 text-slate-400"><%= i + 1 %></td>
                <td class="py-2 pr-3"><time datetime="<%= location.recorded_at.iso8601 %>"><%= l(location.recorded_at, format: :long) %></time></td>
                <td class="py-2 pr-3 text-slate-600"><%= location.latitude.round(5) %>, <%= location.longitude.round(5) %></td>
                <td class="py-2 text-right text-slate-600"><%= location.speed ? "#{location.speed.round(1)} km/h" : "—" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
</div>
