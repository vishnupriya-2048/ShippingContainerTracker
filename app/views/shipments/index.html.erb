<% content_for :main_class, "flex min-h-0 w-full flex-1 flex-col lg:flex-row" %>
<% counts = status_counts(@shipments) %>

<div class="contents" data-controller="map"
     data-map-markers-value="<%= map_markers_for(@shipments).to_json %>">

  <aside class="flex w-full flex-col border-slate-200 bg-white lg:w-[26rem] lg:shrink-0 lg:border-r xl:w-[30rem]">
    <div class="space-y-4 border-b border-slate-100 px-5 pb-4 pt-5">
      <div>
        <h1 class="text-lg font-semibold tracking-tight">Shipments</h1>
        <p class="text-sm text-slate-500">Select a shipment to find it on the map.</p>
      </div>

      <dl class="grid grid-cols-4 gap-2 text-center">
        <% [
             ["Total", @shipments.size, "text-slate-900"],
             ["In transit", counts.values_at("picked_up", "in_transit", "out_for_delivery").compact.sum, "text-indigo-600"],
             ["Delivered", counts.fetch("delivered", 0), "text-emerald-600"],
             ["Exceptions", counts.fetch("exception", 0), "text-red-600"]
           ].each do |label, value, color| %>
          <div class="rounded-xl bg-slate-50 px-2 py-2.5 ring-1 ring-inset ring-slate-200/70">
            <dd class="text-xl font-semibold tabular-nums <%= color %>"><%= value %></dd>
            <dt class="text-[11px] font-medium uppercase tracking-wide text-slate-500"><%= label %></dt>
          </div>
        <% end %>
      </dl>
    </div>

    <ul class="max-h-80 flex-1 divide-y divide-slate-100 overflow-y-auto lg:max-h-none">
      <% @shipments.each do |shipment| %>
        <% location = shipment.latest_location %>
        <li id="shipment_<%= shipment.id %>"
            data-map-target="row"
            data-map-id-param="<%= shipment.id %>"
            data-action="click->map#select keydown.enter->map#select"
            tabindex="0"
            class="group cursor-pointer border-l-4 border-transparent px-5 py-4 outline-none transition hover:bg-slate-50 focus-visible:bg-slate-50 aria-selected:border-indigo-500 aria-selected:bg-indigo-50/60">
          <div class="flex items-start justify-between gap-3">
            <%= link_to shipment.shipment_identifier, shipment,
                  class: "font-semibold text-slate-900 hover:text-indigo-600",
                  data: { action: "click->map#ignore" } %>
            <%= status_badge(shipment.current_status) %>
          </div>

          <div class="mt-2.5 flex items-stretch gap-3 text-sm">
            <div class="flex flex-col items-center py-1" aria-hidden="true">
              <span class="size-2 rounded-full border-2 border-slate-400"></span>
              <span class="w-px flex-1 bg-slate-200"></span>
              <span class="size-2 rounded-full bg-slate-700"></span>
            </div>
            <div class="min-w-0 space-y-1.5 text-slate-600">
              <p class="truncate" title="<%= shipment.source_address %>"><%= shipment.source_address %></p>
              <p class="truncate font-medium text-slate-800" title="<%= shipment.destination_address %>"><%= shipment.destination_address %></p>
            </div>
          </div>

          <p class="mt-3 flex items-center gap-1.5 text-xs text-slate-500">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <% if location %>
              Last seen
              <time datetime="<%= location.recorded_at.iso8601 %>" title="<%= l(location.recorded_at, format: :long) %>">
                <%= time_ago_in_words(location.recorded_at) %> ago
              </time>
            <% else %>
              No location reported yet
            <% end %>
          </p>
        </li>
      <% end %>

      <% if @shipments.empty? %>
        <li class="px-5 py-16 text-center">
          <p class="font-medium text-slate-700">No shipments yet</p>
          <p class="mt-1 text-sm text-slate-500">Create one, or run <code class="rounded bg-slate-100 px-1.5 py-0.5 text-xs">bin/rails db:seed</code>.</p>
        </li>
      <% end %>
    </ul>
  </aside>

  <section class="relative min-h-[22rem] flex-1 bg-slate-200">
    <div data-map-target="canvas" class="absolute inset-0"></div>

    <div data-map-target="message" hidden
         class="absolute inset-0 grid place-items-center bg-slate-100 p-8 text-center">
      <div class="max-w-sm">
        <p class="font-semibold text-slate-800">The map couldn't be loaded</p>
        <p class="mt-1 text-sm text-slate-500">Check that <code class="rounded bg-white px-1 py-0.5 text-xs">MAPS_JS_API_KEY</code> is set in <code class="rounded bg-white px-1 py-0.5 text-xs">.env</code> and that the Maps JavaScript API is enabled for it (see setup.md, section 12).</p>
      </div>
    </div>
  </section>
</div>
